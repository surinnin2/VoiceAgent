// VoiceAgent data model.
// A Recording stores the raw audio once; it has many TranscriptionAttempts so the
// user can re-run transcription with a different engine / keyterms without re-recording.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Recording {
  id                 String                 @id @default(cuid())
  filename           String
  mimeType           String
  storagePath        String // path under ./storage, e.g. "audio/<id>.webm"
  sizeBytes          Int
  durationMs         Int?
  preferredAttemptId String? // the attempt the user "starred" as the best result
  createdAt          DateTime               @default(now())
  attempts           TranscriptionAttempt[]
  note               Note? // the categorized voice-note produced from this recording
}

// A categorized voice-note: the user-facing object. Its `body` is seeded from the recording's
// transcription but is independently editable, so hand-edits survive a re-transcription.
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String? // optional hex accent
  isInbox   Boolean  @default(false) // the default bucket; capture never blocks on a choice
  position  Int      @default(0)
  createdAt DateTime @default(now())
  notes     Note[]
}

model Note {
  id          String     @id @default(cuid())
  title       String? // auto-derived from the transcript (first line), user-editable
  body        String     @default("") // editable text, seeded from the transcription
  edited      Boolean    @default(false) // true once the user edits body — blocks auto-overwrite
  status      String     @default("transcribing") // transcribing | done | error
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id])
  recordingId String?    @unique // the source audio (one note per recording)
  recording   Recording? @relation(fields: [recordingId], references: [id])
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([categoryId])
}

model TranscriptionAttempt {
  id            String    @id @default(cuid())
  recordingId   String
  recording     Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  provider      String // 'assemblyai' | 'elevenlabs' | 'deepgram' | 'mock'
  model         String
  status        String    @default("queued") // queued | processing | done | error
  languageCode  String    @default("en")
  keyterms      String? // JSON-encoded string[] (domain vocab / proper nouns)
  contextPrompt String?
  // "Only my voice": diarize, then keep only the enrolled/selected speaker's words.
  diarized            Boolean @default(false)
  onlyEnrolledSpeaker Boolean @default(false)
  enrolledSpeaker     String? // the speaker label we tried to match (from Enrollment)
  text          String?
  words         String? // JSON-encoded { text, start, end, confidence, speaker }[]
  errorMessage  String?
  durationMs    Int? // wall-clock time the transcription took
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([recordingId])
}

// Singleton (id = "default") for this single-user app. Holds the consent record and the
// ElevenLabs Speaker Library speaker name to match against ("only my voice").
// A voiceprint reference is BIOMETRIC data — we store only the library label + consent,
// never raw enrollment audio.
model Enrollment {
  id             String    @id // always "default"
  label          String    @default("Me") // display label
  provider       String    @default("elevenlabs")
  speakerLabel   String? // the speaker_id/name registered in the provider's Speaker Library
  consentGiven   Boolean   @default(false)
  consentAt      DateTime?
  consentVersion String    @default("v1")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
