# --- Database (Prisma) ---
# SQLite by default for zero-setup local dev. Swap to Postgres for production:
#   DATABASE_URL="postgresql://user:pass@host:5432/voiceagent"
DATABASE_URL="file:./dev.db"

# --- Transcription providers ---
# Leave keys blank to run on the built-in always-available "mock" engine.
# The default engine is the first AVAILABLE provider in this order:
# AssemblyAI -> ElevenLabs -> Deepgram -> mock.
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# Optional model overrides (verify current model IDs against each provider's docs).
ASSEMBLYAI_SPEECH_MODEL=universal-3-pro
ELEVENLABS_MODEL=scribe_v2
DEEPGRAM_MODEL=nova-3
