# --- Database (Prisma + Postgres) ---
# Postgres (e.g. Supabase). Serverless needs the POOLED connection for the app and a
# DIRECT connection for migrations:
#   DATABASE_URL = Supabase "Transaction pooler" (port 6543), with ?pgbouncer=true
#   DIRECT_URL   = Supabase "Session pooler" / direct (port 5432), used by prisma migrate
# Get both from the Supabase dashboard → Connect → ORMs/Prisma tab.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres"

# --- Transcription providers ---
# Leave keys blank to run on the built-in always-available "mock" engine.
# The default engine is the first AVAILABLE provider in this order:
# AssemblyAI -> ElevenLabs -> Deepgram -> mock.
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# Optional model overrides (verify current model IDs against each provider's docs).
ASSEMBLYAI_SPEECH_MODEL=universal-3-pro
ELEVENLABS_MODEL=scribe_v2
DEEPGRAM_MODEL=nova-3
